# Copy to .env at repository root. Never commit .env.
FLASK_SECRET_KEY=replace-with-a-random-secret
SIMULATOR_TOKEN=replace-with-another-random-secret
SESSION_COOKIE_SECURE=0
MSSQL_HOST=127.0.0.1
MSSQL_PORT=14330
MSSQL_DATABASE=SwiftletCare
MSSQL_APP_USER=your-restricted-service-login
MSSQL_APP_PASSWORD=replace-locally
# Timezone actually used for legacy SYSDATETIME values; Linux SQL image normally UTC.
# Extension event/control times are explicitly Asia/Ho_Chi_Minh and handled separately.
MSSQL_TIMEZONE=UTC
