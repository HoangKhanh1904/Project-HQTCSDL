# Thêm các dòng này vào .env (KHÔNG commit .env). Ví dụ giá trị, hãy thay bằng giá trị riêng.
FLASK_SECRET_KEY=THAY_BANG_CHUOI_NGAU_NHIEN_DAI
SIMULATOR_TOKEN=THAY_BANG_TOKEN_NGAU_NHIEN_DAI
# Tài khoản SQL quyền hạn chế do TV1 cấp (KHÔNG dùng sa / db_owner)
MSSQL_APP_USER=
MSSQL_APP_PASSWORD=
# Tùy chọn
MSSQL_HOST=127.0.0.1
MSSQL_PORT=14330
MSSQL_DATABASE=SwiftletCare
# P3: thong bao qua Gmail SMTP (khong co thi chi dung thong bao trong app).
# SMTP_PASSWORD la App Password cua tai khoan Gmail dung de gui mail
# (Google Account > Security > 2-Step Verification > App passwords).
# SMTP_FROM de trong thi dung SMTP_USER. NOTIFY_EMAILS: danh sach email
# nhan canh bao, cach nhau bang dau phay.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
NOTIFY_EMAILS=
